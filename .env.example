# Anthropic API key for the BPMN conversion routes (POST /api/bpmn/convert,
# POST /api/bpmn/clarify). Create one at https://console.anthropic.com/.
#
# Alternative for local development: run `ant auth login` instead and leave this
# unset — the SDK reads the stored profile automatically. Do not set an empty
# ANTHROPIC_API_KEY, which outranks the profile and authenticates as nothing.
ANTHROPIC_API_KEY=

# Postgres connection string. Required by @workspace/db.
DATABASE_URL=

# Port the API server listens on (defaults to 3000 if unset).
# PORT=
