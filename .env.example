# Copy to `.env` at the repo root. `pnpm --filter @workspace/api-server run start`
# loads it via node's --env-file-if-exists; on Vercel these come from the
# project's environment variables instead, and this file is not used.

# Anthropic API key for the BPMN conversion routes (POST /api/bpmn/convert,
# POST /api/bpmn/clarify). Create one at https://console.anthropic.com/.
#
# Leave this commented out rather than blank if you are not using a key. An
# empty ANTHROPIC_API_KEY still occupies its slot in the SDK's credential
# precedence chain and authenticates as nothing, which surfaces as a confusing
# 401 rather than a clear "no credentials" error.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Port the API server listens on (defaults to 3000 if unset).
# PORT=
